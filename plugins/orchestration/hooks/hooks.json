{
  "description": "Hooks for the orchestration tools: a Stop hook that hands a note written in the Reader to the orchestrator it is addressed to and checks reply links, and PreToolUse hooks that stop common errors before they run.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/orchestrating-parallel-sessions/scripts/orchdoc_stop_check.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/orchestrating-parallel-sessions/scripts/stop_check_reader_links.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/orchestrating-parallel-sessions/scripts/block_python_heredoc.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/orchestrating-parallel-sessions/scripts/block_uncited_seed.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/orchestrating-parallel-sessions/scripts/block_browse_instead_of_route.py\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/orchestrating-parallel-sessions/scripts/block_browse_instead_of_route.py\""
          }
        ]
      }
    ]
  }
}
